{
  "version": 2,
  "routes": [
    {
      "src": "/api/auth(/.*)?",
      "dest": "backend/auth-service/src/index.js"
    },
    {
      "src": "/api/bookings(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/rooms(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/admin(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/calendar(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/reviewer(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/approver(/.*)?",
      "dest": "backend/booking-service/src/index.js"
    },
    {
      "src": "/api/notifications(/.*)?",
      "dest": "backend/notification-service/src/index.js"
    },
    {
      "src": "/_next/static/(.*)",
      "dest": "frontend/_next/static/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "builds": [
    {
      "src": "backend/auth-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/booking-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/notification-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ]
}