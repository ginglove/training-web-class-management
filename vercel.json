{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/backend/auth-service/src/index.js"
    },
    {
      "source": "/api/bookings/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/rooms/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/calendar/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/reviewer/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/approver/:path*",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/notifications/:path*",
      "destination": "/backend/notification-service/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "builds": [
    {
      "src": "backend/auth-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/booking-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/notification-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ]
}