{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/backend/auth-service/src/index.js"
    },
    {
      "source": "/api/bookings/(.*)",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/rooms/(.*)",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/calendar/(.*)",
      "destination": "/backend/booking-service/src/index.js"
    },
    {
      "source": "/api/notifications/(.*)",
      "destination": "/backend/notification-service/src/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "builds": [
    {
      "src": "backend/auth-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/booking-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "backend/notification-service/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ]
}
